{
  "name": "cutline-functions",
  "description": "Cloud Functions behind Cutline's AI features: auto-captions, reference-based auto-edit and trend suggestions.",
  "private": true,
  "main": "index.js",
  "engines": { "node": "22" },
  "scripts": {
